<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeePooFinder.Views.PlacesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PeePooFinder.ViewModels"
    xmlns:models="clr-namespace:PeePooFinder.Models"
    xmlns:controls="clr-namespace:PeePooFinder.Views.Controls"
    x:DataType="vm:PlacesViewModel"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource Page}">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="16,20,16,10" Spacing="12">
            <Label Text="Nearby" Style="{StaticResource Eyebrow}" />
            <Label Text="Where's the restroom?" Style="{StaticResource Headline}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Placeholder="Search a name, area or street" Text="{Binding SearchText}" Style="{StaticResource FieldEntry}"
                       ReturnType="Search" ReturnCommand="{Binding SearchCommand}" ClearButtonVisibility="WhileEditing" />
            </Border>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Accessible" Style="{StaticResource FilterChip}" Command="{Binding ToggleAccessibleCommand}"
                            BackgroundColor="{Binding OnlyAccessible, Converter={StaticResource ChipBackground}}"
                            TextColor="{Binding OnlyAccessible, Converter={StaticResource ChipText}}" />
                    <Button Text="Changing table" Style="{StaticResource FilterChip}" Command="{Binding ToggleBabyChangerCommand}"
                            BackgroundColor="{Binding OnlyBabyChanger, Converter={StaticResource ChipBackground}}"
                            TextColor="{Binding OnlyBabyChanger, Converter={StaticResource ChipText}}" />
                    <Button Text="Free" Style="{StaticResource FilterChip}" Command="{Binding ToggleFreeCommand}"
                            BackgroundColor="{Binding OnlyFree, Converter={StaticResource ChipBackground}}"
                            TextColor="{Binding OnlyFree, Converter={StaticResource ChipText}}" />
                    <Button Text="Open" Style="{StaticResource FilterChip}" Command="{Binding ToggleOpenCommand}"
                            BackgroundColor="{Binding OnlyOpen, Converter={StaticResource ChipBackground}}"
                            TextColor="{Binding OnlyOpen, Converter={StaticResource ChipText}}" />
                </HorizontalStackLayout>
            </ScrollView>
            <Label Text="{Binding StatusText}" Style="{StaticResource Caption}" IsVisible="{Binding StatusText, Converter={StaticResource StringHasValue}}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}" RefreshColor="{StaticResource SignDeep}">
            <CollectionView ItemsSource="{Binding Places}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,40" Spacing="8">
                        <Label Text="Nothing here yet" Style="{StaticResource Title}" />
                        <Label Text="Try removing a filter, or add the first place with the + button." Style="{StaticResource Body}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Place">
                        <controls:PlaceCard Margin="16,6">
                            <controls:PlaceCard.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlacesViewModel}}, Path=GoToDetailCommand, x:DataType=vm:PlacesViewModel}"
                                    CommandParameter="{Binding .}" />
                            </controls:PlaceCard.GestureRecognizers>
                        </controls:PlaceCard>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="96" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Add place: a square sign button rather than a floating circle. -->
        <Button Grid.Row="1"
                Text="+ Add a place"
                Style="{StaticResource SignButton}"
                HorizontalOptions="End" VerticalOptions="End"
                Padding="18,0"
                Margin="0,0,16,16"
                Command="{Binding AddPlaceCommand}"
                SemanticProperties.Description="Add a restroom to the map" />
    </Grid>
</ContentPage>
