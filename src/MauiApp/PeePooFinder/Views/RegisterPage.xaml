<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeePooFinder.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PeePooFinder.ViewModels"
    x:DataType="vm:RegisterViewModel"
    Title="Create account"
    Style="{StaticResource Page}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Join the map" Style="{StaticResource Headline}" />
            <Label Text="Free, no ads. Your email is never shown to anyone." Style="{StaticResource Caption}" />

            <Label Text="Name people will see" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Text="{Binding DisplayName}" MaxLength="40" Style="{StaticResource FieldEntry}" />
            </Border>

            <Label Text="Username" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Text="{Binding Username}" MaxLength="24" Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Style="{StaticResource FieldEntry}" />
            </Border>
            <Label Text="3–24 letters, numbers, dots or underscores." Style="{StaticResource Caption}" Margin="0,-8,0,0" />

            <Label Text="Email" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Keyboard="Email" Text="{Binding Email}" MaxLength="100" Style="{StaticResource FieldEntry}" />
            </Border>

            <Label Text="Password" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry IsPassword="True" Text="{Binding Password}" MaxLength="128" Style="{StaticResource FieldEntry}" />
            </Border>
            <Label Text="At least 8 characters, with an uppercase letter, a lowercase letter and a number." Style="{StaticResource Caption}" Margin="0,-8,0,0" />

            <Button Text="Create account" Style="{StaticResource PrimaryButton}" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource SignDeep}" />
            <Button Text="I already have an account" Style="{StaticResource LinkButton}" HorizontalOptions="Center" Command="{Binding BackToLoginCommand}" />
            <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center">
                <Label.Text>By creating an account you agree to the Terms of Use and Privacy Policy.</Label.Text>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
