<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeePooFinder.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PeePooFinder.ViewModels"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource Page}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,32" Spacing="18">
            <!-- Wayfinding sign as the brand moment -->
            <Border Style="{StaticResource SignPanel}" Rotation="-1.5" Padding="20" Margin="0,0,0,12">
                <VerticalStackLayout Spacing="6">
                    <Image Source="logo.png" HeightRequest="56" WidthRequest="56" HorizontalOptions="Start" />
                    <Label Text="PeePoo Finder" FontFamily="Display" FontSize="38" TextColor="{StaticResource OnSign}" LineHeight="0.95" />
                    <BoxView HeightRequest="3" Color="{StaticResource OnSign}" Margin="0,6" />
                    <Label Text="Restrooms near you, with hours, access and real reviews." FontFamily="BodyBold" FontSize="16" TextColor="{StaticResource OnSign}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Sign in" Style="{StaticResource Headline}" />
            <Label Text="An account lets you add places, write reviews and save favorites." Style="{StaticResource Caption}" />

            <Label Text="Email" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Keyboard="Email" Text="{Binding Email}" Style="{StaticResource FieldEntry}" ReturnType="Next" />
            </Border>

            <Label Text="Password" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry IsPassword="True" Text="{Binding Password}" Style="{StaticResource FieldEntry}" ReturnType="Go" ReturnCommand="{Binding LoginCommand}" />
            </Border>

            <Button Text="Sign in" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,6,0,0" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource SignDeep}" />

            <BoxView Style="{StaticResource Divider}" Margin="0,8" />
            <Button Text="Create a free account" Style="{StaticResource GhostButton}" Command="{Binding GoToRegisterCommand}" />
            <Button Text="Browse without an account →" Style="{StaticResource LinkButton}" HorizontalOptions="Center" Command="{Binding ContinueAsGuestCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
