<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeePooFinder.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PeePooFinder.ViewModels"
    x:DataType="vm:ProfileViewModel"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource Page}">

    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,32" Spacing="18">

            <!-- Guest -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsGuest}">
                <Label Text="You" Style="{StaticResource Eyebrow}" />
                <Label Text="Help keep the map honest." Style="{StaticResource Headline}" />
                <Label Text="With a free account you can add places, write reviews, save favorites and confirm that a place is still good." Style="{StaticResource Body}" />
                <Button Text="Create a free account" Style="{StaticResource SignButton}" Command="{Binding CreateAccountCommand}" />
                <Button Text="I already have an account" Style="{StaticResource GhostButton}" Command="{Binding SignInCommand}" />
            </VerticalStackLayout>

            <!-- Signed in -->
            <VerticalStackLayout Spacing="18" IsVisible="{Binding IsSignedIn}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Style="{StaticResource SignPanel}" WidthRequest="72" HeightRequest="72" Padding="0">
                        <Label Text="{Binding Initial}" FontFamily="Display" FontSize="34" TextColor="{StaticResource OnSign}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding DisplayName}" Style="{StaticResource Title}" FontSize="24" />
                        <Label Text="{Binding Username, StringFormat='@{0}'}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Grid>
                <Label Text="{Binding StatsLabel}" Style="{StaticResource Caption}" />

                <Border Style="{StaticResource Card}" Padding="16,4">
                    <VerticalStackLayout>
                        <Button Text="Saved places  →" Style="{StaticResource RowButton}" HorizontalOptions="Fill" Command="{Binding OpenSavedCommand}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray900}}" />
                        <Button Text="Places you added  →" Style="{StaticResource RowButton}" HorizontalOptions="Fill" Command="{Binding OpenMinePlacesCommand}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray900}}" />
                        <Button Text="Your reviews  →" Style="{StaticResource RowButton}" HorizontalOptions="Fill" Command="{Binding OpenMyReviewsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Edit profile" Style="{StaticResource Title}" />
                <Label Text="Name people see" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Entry Text="{Binding DisplayName}" MaxLength="40" Style="{StaticResource FieldEntry}" />
                </Border>
                <Label Text="About you (optional)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}" Padding="12,4">
                    <Editor Text="{Binding Bio}" MaxLength="300" Style="{StaticResource FieldEditor}" MinimumHeightRequest="70" />
                </Border>
                <Button Text="Save changes" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />

                <Border Style="{StaticResource Card}" Padding="16,4">
                    <VerticalStackLayout>
                        <Button Text="Change password  →" Style="{StaticResource RowButton}" HorizontalOptions="Fill" Command="{Binding OpenChangePasswordCommand}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray900}}" />
                        <Button Text="Blocked people  →" Style="{StaticResource RowButton}" HorizontalOptions="Fill" Command="{Binding OpenBlockedCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <BoxView Style="{StaticResource Divider}" />
            <VerticalStackLayout Spacing="0">
                <Button Text="Help &amp; FAQ" Style="{StaticResource LinkButton}" Command="{Binding OpenHelpCommand}" />
                <Button Text="Privacy policy" Style="{StaticResource LinkButton}" Command="{Binding OpenPrivacyCommand}" />
                <Button Text="Terms of use" Style="{StaticResource LinkButton}" Command="{Binding OpenTermsCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsSignedIn}">
                <Button Text="Sign out" Style="{StaticResource GhostButton}" Command="{Binding LogoutCommand}" />
                <Button Text="Delete account" Style="{StaticResource DangerButton}" Command="{Binding DeleteAccountCommand}" />
            </VerticalStackLayout>

            <Label Text="{Binding AppVersion}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource SignDeep}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
